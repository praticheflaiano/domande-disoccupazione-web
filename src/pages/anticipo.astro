---
import Base from '../layouts/Base.astro';
import AnticipoNaspi from '../components/AnticipoNaspi';
import RelatedPages from '../components/RelatedPages.astro';

const breadcrumbs = [
    { label: 'Home', href: '/' },
    { label: 'Anticipo NASpI', href: '/anticipo' },
];

// Le risposte riprendono il testo visibile della pagina (componente AnticipoNaspi).
const faq = [
    {
        q: "Come viene pagato l'anticipo NASpI nel 2026?",
        a: "Per le domande presentate dal 1° gennaio 2026 l'anticipo è pagato in due rate: il 70% quando la domanda viene accolta e il 30% alla fine del periodo teorico della NASpI, comunque non oltre 6 mesi dalla domanda (art. 8, c. 3-bis, d.lgs. 22/2015; messaggio INPS 1215/2026).",
    },
    {
        q: "Entro quando si presenta la domanda di anticipo NASpI?",
        a: "Entro 30 giorni dall'inizio dell'attività autonoma o dell'impresa individuale, o dalla sottoscrizione della quota di cooperativa. Se l'attività era iniziata prima della fine del lavoro dipendente, entro 30 giorni dalla domanda NASpI.",
    },
    {
        q: "Chi può chiedere l'anticipo NASpI?",
        a: "Chi ha diritto alla NASpI e vuole avviare un lavoro autonomo, un'impresa individuale, sottoscrivere una quota di una cooperativa in cui lavora come socio, oppure portare a tempo pieno un'attività autonoma iniziata prima della fine del lavoro dipendente.",
    },
    {
        q: "Cosa succede se trovo lavoro come dipendente dopo l'anticipo?",
        a: "Se il lavoro dipendente inizia prima della fine del periodo teorico della NASpI, il 30% non viene pagato e va restituito anche il 70% già ricevuto, salvo il lavoro con la cooperativa di cui si è soci.",
    },
];
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
    title="Anticipo NASpI 2026: due rate 70% e 30%, requisiti e calcolo"
    description="Anticipo NASpI dal 2026: 70% subito e 30% dopo, domanda entro 30 giorni dall'avvio dell'attività. Chi può chiederlo e calcolo delle due rate."
    breadcrumbs={breadcrumbs}
    jsonLd={jsonLd}
>
    <AnticipoNaspi client:load />

    <RelatedPages current="anticipo" />
</Base>
