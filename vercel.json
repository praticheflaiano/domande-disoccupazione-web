{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/calcolatore",
      "destination": "https://praticheflaiano.it/calcolo-naspi",
      "permanent": true
    },
    {
      "source": "/anticipo",
      "destination": "https://praticheflaiano.it/anticipo-naspi",
      "permanent": true
    },
    {
      "source": "/guida/presentare-domanda",
      "destination": "https://praticheflaiano.it/naspi/domanda",
      "permanent": true
    },
    {
      "source": "/guida/fondo-garanzia-tfr",
      "destination": "https://praticheflaiano.it/naspi/fondo-garanzia-tfr",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.domandedisoccupazione.it"
        }
      ],
      "destination": "https://domandedisoccupazione.it/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.domandedisoccupazione.it"
        }
      ],
      "destination": "https://domandedisoccupazione.it/:path*",
      "permanent": true
    }
  ]
}
